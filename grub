# GRUB boot loader configuration

GRUB_DEFAULT=0
GRUB_TIMEOUT=3
GRUB_DISTRIBUTOR="Gentoo"
GRUB_DISABLE_SUBMENU=u
GRUB_SAVEDEFAULT=true
GRUB_CMDLINE_LINUX_DEFAULT="secure boot amd_pstate=active processor.ignore_ppc=1 amdgpu.ppfeaturemask=0xffffffff ec_sys.write_support=1 fsck.mode=skip loglevel=3 console=tty2 udev.log_level=3 vt.global_cursor_default=0 mitigations=off spec_store_bypass_disable spectre_v2 nowatchdog libahci.ignore_sss=1 msr.allow_writes=on pcie_aspm=force module.sig_unenforce initcall_debug no_timer_check noreplace-smp page_alloc.shuffle=1 rcupdate.rcu_expedited=1 tsc=reliable elevator=none"
GRUB_DISABLE_RECOVERY=true
#GRUB_THEME="/usr/share/grub/themes/catppuccin-mocha-grub-theme/theme.txt"
GRUB_GFXMODE=1920x1080

# Comment if you don't want GRUB to pass "root=PARTUUID=xxx" parameter to kernel
GRUB_DISABLE_LINUX_PARTUUID=false


# Uncomment to disable generation of the submenu and put all choices on
# the top-level menu.
# Besides the visual affect of no sub menu, this makes navigation of the
# menu easier for a user who can't see the screen.
#GRUB_DISABLE_SUBMENU=y

# Uncomment to play a tone when the main menu is displayed.
# This is useful, for example, to allow users who can't see the screen
# to know when they can make a choice on the menu.
#GRUB_INIT_TUNE="60 800 1"
